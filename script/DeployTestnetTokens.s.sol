pragma solidity 0.8.30;

import {Script, console2} from "forge-std/Script.sol";
import {RixorTestToken} from "../contracts/testtokens/RixorTestToken.sol";

/// @notice TESTNET / LOCAL ONLY. Deploys the three valueless TEST tokens for the Robinhood Chain testnet demo and
///         writes a ready-to-review Rixor config to deployments/<chainId>-testnet-config.json.
///
///   node scripts/forge.mjs script script/DeployTestnetTokens.s.sol --rpc-url <testnet> --broadcast <signer>
///
/// Defaults (reviewed in docs/LAUNCH_RUNBOOK.md §3):
///   tMEMEA  "Rixor Test Meme A (TEST)"  18 decimals  supply 1,000,000,000  faucet 100,000/day  Class A
///           unit 1,000   cap 20,000,000 (2% of supply)
///   tMEMEB  "Rixor Test Meme B (TEST)"   6 decimals  supply 1,000,000,000  faucet 100,000/day  Class B
///           unit 1,000   cap 10,000,000 (1% of supply)    (6 decimals exercises the Locker's lower bound)
///   tWIF    "Rixor Test Reward (TEST)"  18 decimals  supply 1,000,000,000  faucet 250,000/day  reward token only
///   Challenges minimum hold: 3,600 s (the contract's lower bound; production uses 86,400 s).
/// The whole initial supply goes to the broadcasting deployer, which later seeds TEST reward streams.
contract DeployTestnetTokens is Script {
    function run() external returns (address memeA, address memeB, address reward) {
        require(block.chainid == 46630 || block.chainid == 31337, "TEST tokens are for Robinhood Chain testnet or a local chain only");
        address deployer = msg.sender;
        vm.startBroadcast();
        memeA = address(new RixorTestToken("Rixor Test Meme A (TEST)", "tMEMEA", 18, 1_000_000_000e18, deployer, 100_000e18));
        memeB = address(new RixorTestToken("Rixor Test Meme B (TEST)", "tMEMEB", 6, 1_000_000_000e6, deployer, 100_000e6));
        reward = address(new RixorTestToken("Rixor Test Reward (TEST)", "tWIF", 18, 1_000_000_000e18, deployer, 250_000e18));
        vm.stopBroadcast();

        string memory a = "a";
        vm.serializeAddress(a, "token", memeA);
        vm.serializeString(a, "unitAmount", vm.toString(uint256(1_000e18)));
        vm.serializeString(a, "maxTotalLocked", vm.toString(uint256(20_000_000e18)));
        string memory la = vm.serializeUint(a, "riskClass", 1);
        string memory b = "b";
        vm.serializeAddress(b, "token", memeB);
        vm.serializeString(b, "unitAmount", vm.toString(uint256(1_000e6)));
        vm.serializeString(b, "maxTotalLocked", vm.toString(uint256(10_000_000e6)));
        string memory lb = vm.serializeUint(b, "riskClass", 2);

        string memory out = string.concat(
            '{"_note":"TESTNET config generated by DeployTestnetTokens. TEST tokens only; valueless; review before DeployRixorV2.",',
            '"wif":"', vm.toString(reward), '","minHoldSeconds":3600,"listings":[', la, ",", lb, "]}"
        );
        string memory file = string.concat("deployments/", vm.toString(block.chainid), "-testnet-config.json");
        vm.writeFile(file, out);
        console2.log("tMEMEA", memeA);
        console2.log("tMEMEB", memeB);
        console2.log("tWIF", reward);
        console2.log("config", file);
    }
}
