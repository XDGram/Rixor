# Never commit a funded private key. Use a dedicated testnet deployer only.
RIXOR_DEPLOYER_PRIVATE_KEY=
RIXOR_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
RIXOR_ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Filled after deployment and exposed to the Vite frontend.
VITE_RIXOR_SEPOLIA_ADDRESS=0x1B644D969D0b755770033AC332BaCCeFBdbc18bA
VITE_RIXOR_ROBINHOOD_TESTNET_ADDRESS=0xeFddb13d2d3a88E65C0e935603eA26a849f6239b

# Conviction vault on Robinhood Chain TESTNET. Fill after: npm run contract:deploy:vault -- robinhood-testnet
RIXOR_VAULT_TOKEN=
RIXOR_VAULT_ORACLE=
RIXOR_VAULT_MOCK_ORACLE_PRICE=
VITE_RIXOR_VAULT_ADDRESS=
VITE_RIXOR_VAULT_FROM_BLOCK=
VITE_RIXOR_VAULT_MOCK_ORACLE=true
