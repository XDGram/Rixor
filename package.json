{
  "name": "rixor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "contract:compile": "node scripts/compile-contract.mjs",
    "contract:deploy": "node scripts/deploy-contract.mjs",
    "contract:test": "npm run contract:compile && node scripts/test-contract.mjs && node scripts/test-conviction-vault.mjs",
    "contract:deploy:vault": "node scripts/deploy-conviction-vault.mjs",
    "test:pricing": "node scripts/test-pricing.mjs",
    "test:signer-sets": "node scripts/test-signer-sets.mjs",
    "test:safe-signing": "node scripts/test-safe-signing.mjs",
    "test:wallet-switch": "node scripts/test-wallet-switch.mjs",
    "check:live-price": "node scripts/test-pricing.mjs --live",
    "forge": "node scripts/forge.mjs",
    "test:contracts": "node scripts/forge.mjs test --no-match-path 'test/fork/*'",
    "test:fork": "node scripts/forge.mjs test --match-path 'test/fork/*' -vv",
    "vet:token": "node scripts/vet-token.mjs",
    "demo:artifacts": "node scripts/export-demo-artifacts.mjs",
    "demo:backend": "cd demo/fork-backend && npm ci && STATE_DIR=./data npm start",
    "demo:e2e": "node demo/e2e/journey.mjs",
    "demo:e2e:mainnet": "node demo/e2e/mainnet-journey.mjs",
    "demo:e2e:lite": "node demo/e2e/lite-journey.mjs",
    "demo:snapshot": "node scripts/build-browser-snapshot.mjs",
    "demo:verify": "node scripts/verify-browser-evm.mjs",
    "deploy:local-fork": "node scripts/deploy-local-fork.mjs",
    "rehearse:testnet": "node scripts/rehearse-testnet.mjs",
    "rehearse:mainnet": "node scripts/rehearse-mainnet.mjs",
    "plan:testnet": "node scripts/plan-testnet.mjs",
    "preflight:testnet": "node scripts/preflight-testnet.mjs",
    "audit:mainnet-guards": "node scripts/audit-mainnet-guards.mjs",
    "build:deploy-console": "vite build --base ./ --outDir dist-console --emptyOutDir",
    "deploy:bundle": "node scripts/export-deploy-bundle.mjs",
    "deploy:station": "node scripts/deploy-console/station.mjs",
    "test:deploy-console": "node scripts/test-deploy-console.mjs",
    "test:deploy-console-e2e": "node scripts/test-deploy-console-e2e.mjs",
    "test:deploy-console-mainnet": "node scripts/test-deploy-console-mainnet.mjs",
    "test:deploy-console-lite": "node scripts/test-deploy-console-lite.mjs"
  },
  "dependencies": {
    "@ethereumjs/block": "10.1.3",
    "@ethereumjs/common": "10.1.3",
    "@ethereumjs/evm": "10.1.3",
    "@ethereumjs/tx": "10.1.3",
    "@ethereumjs/util": "10.1.3",
    "@ethereumjs/vm": "10.1.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/cast": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
