{
  "name": "rixor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "contract:compile": "node scripts/compile-contract.mjs",
    "contract:deploy": "node scripts/deploy-contract.mjs",
    "contract:test": "npm run contract:compile && node scripts/test-contract.mjs",
    "video:studio": "remotion studio",
    "video:render": "remotion render RixorIntro out/rixor-intro.mp4",
    "video:sound": "python3 remotion/audio/make-soundtrack.py",
    "video:render:film": "remotion render RixorFilm out/rixor-film.mp4 --crf=16",
    "video:render:demo": "remotion render RixorDemo out/rixor-demo.mp4 --crf=16",
    "video:render:square": "remotion render RixorIntroSquare out/rixor-intro-square.mp4",
    "video:still": "remotion still RixorIntro out/rixor-intro.png --frame=60",
    "video:typecheck": "tsc -p tsconfig.remotion.json"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@fontsource/inter-tight": "5.3.0",
    "@remotion/animation-utils": "4.0.541",
    "@remotion/fonts": "4.0.541",
    "@remotion/layout-utils": "4.0.541",
    "@remotion/media": "4.0.541",
    "@remotion/media-utils": "4.0.541",
    "@remotion/noise": "4.0.541",
    "@remotion/paths": "4.0.541",
    "@remotion/player": "4.0.541",
    "@remotion/shapes": "4.0.541",
    "@remotion/transitions": "4.0.541",
    "@remotion/zod-types": "4.0.541",
    "motion": "14.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "4.0.541",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.541",
    "@remotion/cli": "4.0.541",
    "@remotion/renderer": "4.0.541",
    "@remotion/tailwind-v4": "4.0.541",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
