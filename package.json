{
  "name": "rixor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "contract:compile": "node scripts/compile-contract.mjs",
    "contract:deploy": "node scripts/deploy-contract.mjs",
    "contract:test": "npm run contract:compile && node scripts/test-contract.mjs && node scripts/test-conviction-vault.mjs",
    "contract:deploy:vault": "node scripts/deploy-conviction-vault.mjs",
    "test:pricing": "node scripts/test-pricing.mjs",
    "check:live-price": "node scripts/test-pricing.mjs --live",
    "forge": "node node_modules/@foundry-rs/forge/bin.mjs",
    "test:contracts": "node node_modules/@foundry-rs/forge/bin.mjs test --no-match-path 'test/fork/*'",
    "test:fork": "node node_modules/@foundry-rs/forge/bin.mjs test --match-path 'test/fork/*' -vv",
    "vet:token": "node scripts/vet-token.mjs",
    "demo:artifacts": "node scripts/export-demo-artifacts.mjs",
    "demo:backend": "cd demo/fork-backend && npm ci && STATE_DIR=./data npm start",
    "demo:e2e": "node demo/e2e/journey.mjs"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "1.7.1",
    "@foundry-rs/cast": "1.7.1",
    "@foundry-rs/forge": "1.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "ethers": "^6.15.0",
    "ganache": "^7.9.2",
    "solc": "^0.8.30",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.1.7"
  }
}
